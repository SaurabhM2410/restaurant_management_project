from django.urls import path
from .views import MenuItemViewSet

menu_item_update = MenuItemViewSet.as_view({
    'put': 'update',
    'patch': 'partial_update'
})

urlpatterns = [
    path('menu/<int:pk>/', menu_item_update, name='menu-item-update'),
]
